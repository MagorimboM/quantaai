// ============================================================
// QUANTA — PRISMA SCHEMA
// Stack: NestJS + PostgreSQL + Prisma + pgvector
//
// OWNERSHIP MODEL:
// userId    = owner of ALL data. Required on every owned table and a
//             real foreign key to users, so a row can never exist
//             without a valid owner.
// companyId = the company the row belongs to. Required wherever a
//             row lives inside a company, and a real foreign key.
//
// There is no "personal" (company-less) data: everything belongs to
// a company. Shared defaults are copied into each company when it
// is created, not stored once with companyId = null.
//
// Workspace sits ABOVE Company only -- a company can have many
// workspaces, but recipes/materials/labour/overheads/categories/
// projects/documents/chat messages are tied directly to a company,
// not separately scoped to a workspace.
//
// Still optional on purpose (null has a real meaning):
//   projectId on documents / chat messages (null = company level),
//   siteConditionId (null = general purpose),
//   australianTradeCodeId (null = a custom trade code),
//   takeoff_items.recipeId (see the note on that model).
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USERS
// Auth handled by Clerk
// ============================================================

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  avatarUrl String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyTeamMembers CompanyTeamMembers[]
  companies          Company[]
  workspaces         Workspace[]
  companyTradeCodes  CompanyTradeCode[]
  categories         Category[]
  materials          Material[]
  labour             Labour[]
  overheads          Overhead[]
  recipes            Recipe[]
  recipeMaterials    RecipeMaterial[]
  recipeLabour       RecipeLabour[]
  recipeOverheads    RecipeOverhead[]
  projects           Project[]
  takeoffItems       TakeoffItem[]
  documents          Document[]
  documentEmbeddings DocumentEmbedding[]
  chatMessages       ChatMessage[]

  @@map("users")
}

// ============================================================
// COMPANY TEAM MEMBERS
// userId    = owner (who added this team member)
// companyId = company this team member belongs to
// ============================================================

model CompanyTeamMembers {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  name        String
  lastName    String
  email       String
  phoneNumber String
  position    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_team_members")
}

// ============================================================
// COMPANIES
// John's company labels — data belongs to John not the company
// userId    = owner of this company label
// completed / completedAt = lifecycle tracking, distinct from isArchived
// ============================================================

model Company {
  id           String     @id @default(uuid())
  userId       String
  name         String
  address      String?
  city         String?
  state        String?
  postcode     String?
  country      String?    @default("Australia")
  phone        String?
  email        String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  companyType  String?
  isArchived   Boolean    @default(false)
  completed    Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspaces         Workspace[]
  companyTradeCodes  CompanyTradeCode[]
  categories         Category[]
  materials          Material[]
  labour             Labour[]
  overheads          Overhead[]
  recipes            Recipe[]
  projects           Project[]
  documents          Document[]
  takeoffItems       TakeoffItem[]
  chatMessages       ChatMessage[]
  companyTeamMembers CompanyTeamMembers[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companies")
}

// ============================================================
// WORKSPACES
// userId    = owner
// companyId = the company this workspace belongs to
//
// Workspace sits ABOVE Company only. It does not scope recipes,
// materials, labour, overheads, categories, projects, documents,
// or chat messages -- those all belong directly to a Company.
// ============================================================

model Workspace {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workspaces")
}

// ============================================================
// AUSTRALIAN TRADE CODES
// Global master list — AIQS standard, read only
// ============================================================

model AustralianTradeCode {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  division    String
  level       String
  unit        String?
  description String?
  createdAt   DateTime @default(now())

  companyTradeCodes CompanyTradeCode[]

  @@map("australian_trade_codes")
}

// ============================================================
// COMPANY TRADE CODES
// userId = owner
// companyId = the company these trade codes belong to
// ============================================================

model CompanyTradeCode {
  id                    String   @id @default(uuid())
  userId                String
  companyId             String
  australianTradeCodeId String?
  code                  String
  name                  String
  unit                  String?
  isCustom              Boolean  @default(false)
  notes                 String?
  createdAt             DateTime @default(now())

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  australianTradeCode AustralianTradeCode? @relation(fields: [australianTradeCodeId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_trade_codes")
}

// ============================================================
// SITE CONDITIONS
// Lookup table — a material, labour item, overhead, or recipe
// can optionally be tied to a specific ground/site condition
// (e.g. muddy, sandy, coastal), since these change what's
// needed to do the same work. Null = general purpose, not
// site-specific.
// ============================================================

model SiteCondition {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  materials Material[]
  labour    Labour[]
  overheads Overhead[]
  recipes   Recipe[]

  @@map("site_conditions")
}

// ============================================================
// CATEGORIES
// userId = owner
// companyId = the company this category belongs to
// isDefault = true  → copied in from the pre-loaded defaults
//
// Category now covers what RecipeType used to -- every recipe
// belongs to exactly one category, and that same category also
// classifies materials, labour and overheads.
// ============================================================

model Category {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materials Material[]
  labour    Labour[]
  overheads Overhead[]
  recipes   Recipe[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("categories")
}

// ============================================================
// MATERIALS
// userId = owner
// companyId = the company this material belongs to
// ============================================================

model Material {
  id              String   @id @default(uuid())
  userId          String
  companyId       String
  categoryId      String
  siteConditionId String?
  name            String
  description     String?
  unit            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id])
  siteCondition   SiteCondition?   @relation(fields: [siteConditionId], references: [id])
  recipeMaterials RecipeMaterial[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("materials")
}

// ============================================================
// LABOUR
// userId = owner
// companyId = the company this labour item belongs to
// ============================================================

model Labour {
  id              String   @id @default(uuid())
  userId          String
  companyId       String
  categoryId      String
  siteConditionId String?
  name            String
  description     String?
  labourType      String
  unit            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  siteCondition SiteCondition? @relation(fields: [siteConditionId], references: [id])
  recipeLabour  RecipeLabour[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("labour")
}

// ============================================================
// OVERHEADS
// userId = owner
// companyId = the company this overhead belongs to
// ============================================================

model Overhead {
  id              String   @id @default(uuid())
  userId          String
  companyId       String
  categoryId      String
  siteConditionId String?
  name            String
  description     String?
  unit            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id])
  siteCondition   SiteCondition?   @relation(fields: [siteConditionId], references: [id])
  recipeOverheads RecipeOverhead[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("overheads")
}

// ============================================================
// RECIPES
// userId = owner
// companyId       = the company this recipe belongs to
// categoryId      = required — every recipe belongs to exactly one
//                    category, but a category can have many recipes
//                    (one-to-many). Category now also covers what
//                    RecipeType used to.
// siteConditionId = optional — null means this recipe isn't tied to
//                    a specific ground/site condition; set means it's
//                    the version of this recipe designed for that
//                    condition (e.g. "110mm Brick Wall - Muddy Site"
//                    vs "110mm Brick Wall" as a plain, general recipe)
// ============================================================

model Recipe {
  id              String   @id @default(uuid())
  userId          String
  companyId       String
  categoryId      String
  siteConditionId String?
  name            String
  description     String?
  unit            String
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id])
  siteCondition   SiteCondition?   @relation(fields: [siteConditionId], references: [id])
  recipeMaterials RecipeMaterial[]
  recipeLabour    RecipeLabour[]
  recipeOverheads RecipeOverhead[]
  takeoffItems    TakeoffItem[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recipes")
}

// ============================================================
// RECIPE MATERIALS
// userId = owner — always follows recipe owner
// ============================================================

model RecipeMaterial {
  id         String  @id @default(uuid())
  userId     String
  recipeId   String
  materialId String
  quantity   Float
  unit       String

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recipe_materials")
}

// ============================================================
// RECIPE LABOUR
// userId = owner — always follows recipe owner
// ============================================================

model RecipeLabour {
  id       String  @id @default(uuid())
  userId   String
  recipeId String
  labourId String
  quantity Float
  unit     String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  labour Labour @relation(fields: [labourId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recipe_labour")
}

// ============================================================
// RECIPE OVERHEADS
// userId = owner — always follows recipe owner
// ============================================================

model RecipeOverhead {
  id         String  @id @default(uuid())
  userId     String
  recipeId   String
  overheadId String
  quantity   Float
  unit       String

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  overhead Overhead @relation(fields: [overheadId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recipe_overheads")
}

// ============================================================
// PROJECTS
// userId = owner
// companyId = the company this project belongs to
// ============================================================

model Project {
  id               String    @id @default(uuid())
  userId           String
  companyId        String
  projectNumber    String
  name             String
  description      String?
  type             String
  status           String    @default("draft")
  stage            String?
  clientName       String?
  clientEmail      String?
  clientPhone      String?
  siteContactName  String?
  siteContactPhone String?
  address          String?
  city             String?
  state            String?
  postcode         String?
  drawingNumber    String?
  revision         String?
  startDate        DateTime?
  endDate          DateTime?
  completed        Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  takeoffItems TakeoffItem[]
  documents    Document[]
  chatMessages ChatMessage[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ============================================================
// TAKEOFF ITEMS
// userId = owner
// companyId = the company (always the same as the project's)
// John inputs ONE measurement — app calculates everything
// ============================================================

// recipeId stays optional on purpose: making it required would make
// deleting a company (which cascades to its recipes and projects) fail
// whenever a takeoff line points at one of its recipes. The app already
// refuses to delete a recipe a takeoff uses.
model TakeoffItem {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  projectId   String
  recipeId    String?
  description String
  measurement Float
  unit        String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipe  Recipe? @relation(fields: [recipeId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("takeoff_items")
}

// ============================================================
// DOCUMENTS
// userId = owner
// companyId = the company the document belongs to
// projectId = null  → company level document (policies, standards)
// projectId = set   → document for that project
// isArchived = true → excluded from AI search / active use
// archivedAt        → timestamp when archived
// archivedReason    → optional note explaining why archived
// ============================================================

model Document {
  id              String    @id @default(uuid())
  userId          String
  companyId       String
  projectId       String?
  name            String
  fileUrl         String
  fileType        String
  documentType    String?
  documentTitle   String?
  documentDate    DateTime?
  documentAuthor  String?
  documentVersion String?
  issuedBy        String?
  extractedText   String?
  status          String    @default("processing")
  isArchived      Boolean   @default(false)
  archivedAt      DateTime?
  archivedReason  String?
  uploadedAt      DateTime  @default(now())

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  embeddings DocumentEmbedding[]
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ============================================================
// DOCUMENT EMBEDDINGS
// userId = owner — follows document owner
// chunkTitle = document name for AI reference
// isArchived = true → excluded from vector search
// archivedAt        → timestamp when archived (mirrors parent doc)
//
// NOTE: embedding column added manually after migration:
//   CREATE EXTENSION IF NOT EXISTS vector;
//   ALTER TABLE document_embeddings ADD COLUMN embedding vector(1536);
//   CREATE INDEX ON document_embeddings USING hnsw (embedding vector_cosine_ops);
// ============================================================

model DocumentEmbedding {
  id         String    @id @default(uuid())
  userId     String
  documentId String
  chunkText  String
  chunkTitle String?
  chunkIndex Int
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("document_embeddings")
}

// ============================================================
// CHAT MESSAGES
// userId = owner
// companyId = the company the chat is about
// projectId = null  → company level AI chat
// projectId = set   → project scoped AI chat
// ============================================================

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  projectId String?
  role      String
  content   String
  createdAt DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
